# Core app
SECRET_KEY=replace-with-a-long-random-value
MONITOR_DATABASE_PATH=./portfolio_monitor.db
PORTFOLIO_PATH=./portfolio.csv
# Hosted services can supply the complete CSV as a secret environment variable.
PORTFOLIO_CSV=

# Optional password protection (recommended for hosted deployments)
WEB_AUTH_USERNAME=
WEB_AUTH_PASSWORD=
# Optional additional users as a JSON object, for example {"analyst":"change-me"}
WEB_AUTH_USERS=

# Shared secret for POST /tasks/refresh (used by Cloud Scheduler)
SCHEDULER_TOKEN=

# Monitoring behavior
REFRESH_INTERVAL_MINUTES=5
ALERT_COOLDOWN_HOURS=24
# 0.005 alerts when the session low is within 0.5% of the rolling low.
LOW_TOLERANCE_PCT=0

# Notification provider: auto, google_chat, mac_messages, or twilio
NOTIFICATION_PROVIDER=mac_messages
MAC_MESSAGES_ENABLED=true
ALERT_TO_NUMBER=+14155550123

# Recommended hosted notification method. The webhook URL is a secret.
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_RECIPIENT_EMAIL=

# Optional Twilio SMS alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
